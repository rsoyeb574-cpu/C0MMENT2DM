# Application Configuration
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Session Security
SESSION_SECRET="comment2dm_super_secret_session_key_2026_dev_mode"

# Token Encryption (AES-256-GCM)
# 32-byte hex or base64 key used to encrypt long-lived user access tokens at rest
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Instagram API with Instagram Login (Business Login for Instagram)
# Obtain these credentials from Meta for Developers (https://developers.facebook.com)
